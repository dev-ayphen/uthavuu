# Copy to .env and fill in. apps/api must be running for any of this to work.
#
# `localhost` is only correct for a SIMULATOR/EMULATOR sharing this machine's
# network stack. On a physical phone `localhost` is the phone itself, every API
# call fails, and the app shows "You appear to be offline" with a Retry that can
# only fail again. For a real device use this machine's LAN IP
# (`ipconfig getifaddr en0` on macOS) with the phone on the same Wi-Fi, e.g.
# http://192.168.1.4:3001 — or, over USB on Android, run
# `adb reverse tcp:3001 tcp:3001` and keep localhost.
EXPO_PUBLIC_API_URL=http://localhost:3001
