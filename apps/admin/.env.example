# Uthavu admin console — copy to .env.local
#
# The API this console talks to. Admin auth is COOKIE/SESSION based (not the
# bearer tokens mobile uses), so this must be an origin the API allows via
# ADMIN_URL in its own CORS config, and requests must be sent with credentials.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Dev-only convenience: renders a "fill demo credentials" affordance on the
# login page. OFF unless explicitly set to "true", and hard-blocked in
# production builds regardless of value. Never put a real password in here.
# NEXT_PUBLIC_ENABLE_LOGIN_DEV_TOOLS=false
